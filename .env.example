# Copy this file to .env and fill in the values. Never commit .env.
# The server reads .env itself at start; nothing else reads it.

# Optional: which LLM profile the server uses. Empty or "default" = the LLM_* values below.
# Any other name, for example LLM_PROFILE=local, makes the server use LLM_LOCAL_BASE_URL,
# LLM_LOCAL_MODEL and LLM_LOCAL_API_KEY instead (any OpenAI-compatible endpoint).
LLM_PROFILE=

# Default profile (OpenAI-compatible format).
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Optional, per profile (LLM_REASONING_PARAM or LLM_<NAME>_REASONING_PARAM): "send" (default) or "omit".
# Optional, per profile (LLM_<NAME>_REASONING_EFFORT): "omit" (default) or "send" to pass thinking levels as
# reasoning_effort. Use "send" only for an endpoint that accepts reasoning_effort.
# "omit" sends no reasoning request parameter. Keep the default unless the measured cache hit rate says otherwise.
LLM_REASONING_PARAM=

# GitHub read-only token (server side only). Optional during early development.
GITHUB_TOKEN=
# Live execution (containers). false: analysis only, an Adapted_Repo Task ends "not executed" at the target check.
GL_EXECUTION_ENABLED=
# Container memory limits in MB (defaults 512, 768, 512, 768, 64)
GL_MEM_SANDBOX_MB=
GL_MEM_DEV_MB=
GL_MEM_RUN_MB=
GL_MEM_TEST_MB=
GL_MEM_PROXY_MB=
# Local path or git bundle to create an Adapter's source mirror from (hosts where large clones fail)
GL_MIRROR_SOURCE_LINKDING=
# Public site: access codes for operating (comma-separated, at least 8 characters each), Tasks per code per day (default 3)
GL_ACCESS_CODES=
GL_ACCESS_CODE_DAILY_TASKS=
# Admin token (at least 16 characters): queue switch, Sandbox restore; entered as the code it unlocks the owner (R42)
GL_ADMIN_TOKEN=
# Open execution (R42): repositories without an Adapter, owner only, after confirming the environment. On unless 0/false.
GL_OPEN_EXECUTION=
# Base image for open execution (default: GL_DEV_IMAGE) and the package indexes used at its build
GL_OPEN_BASE_IMAGE=
GL_PYPI_INDEX=
GL_NPM_REGISTRY=
