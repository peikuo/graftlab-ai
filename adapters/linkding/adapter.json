{
  "id": "linkding",
  "match": {
    "owner": "sissbruecker",
    "repo": "linkding"
  },
  "source": {
    "upstreamUrl": "https://github.com/sissbruecker/linkding",
    "releaseTag": "v1.47.0",
    "commit": "24b5ad6cc9bde497b5d1b1e86aed5a2fb7d25c2f"
  },
  "baseline": {
    "image": "ghcr.io/sissbruecker/linkding@sha256:e35cb50e0581178f245125ffaa909c565416c94c9f22ace305a7d234a4345522",
    "platformManifestDigest": "sha256:b44256a4ff37e4cb1a39c40d3a5b560337f1477a55428b3320e813d6004d8001",
    "configDigest": "sha256:0f9a8582286a2efc50d51724869b48d845fed52032b8d0b45f02ee6ee649a9f3",
    "port": 9090,
    "healthPath": "/health",
    "env": {
      "LD_DISABLE_BACKGROUND_TASKS": "True"
    },
    "secretEnv": [
      "LD_SUPERUSER_NAME",
      "LD_SUPERUSER_PASSWORD"
    ],
    "dataVolumePath": "/etc/linkding/data",
    "readinessTimeoutS": 120
  },
  "api": {
    "read": [
      {
        "method": "GET",
        "path": "/api/bookmarks/"
      },
      {
        "method": "GET",
        "path": "/api/bookmarks/archived/"
      },
      {
        "method": "GET",
        "path": "/api/bookmarks/{id}/"
      },
      {
        "method": "GET",
        "path": "/api/tags/"
      }
    ],
    "write": [
      {
        "method": "POST",
        "path": "/api/bookmarks/",
        "op": "create",
        "query": {
          "disable_scraping": ""
        }
      },
      {
        "method": "PATCH",
        "path": "/api/bookmarks/{id}/",
        "op": "update_tags"
      },
      {
        "method": "POST",
        "path": "/api/bookmarks/{id}/archive/",
        "op": "archive"
      }
    ],
    "itemCap": 10,
    "auth": {
      "header": "Authorization",
      "prefix": "Token ",
      "credential": "linkding_api_token"
    }
  },
  "devSandbox": {
    "baseImage": "ghcr.io/sissbruecker/linkding@sha256:e35cb50e0581178f245125ffaa909c565416c94c9f22ace305a7d234a4345522",
    "preinstalled": [
      "git",
      "node 24",
      "uv 0.8.13",
      "dev dependency group (hash-checked)",
      "npm ci",
      "npm run build"
    ],
    "dependencySetup": "dev-sandbox/setup.sh",
    "path": [
      "/etc/linkding/.venv/bin"
    ],
    "prebuilt": [
      "node_modules",
      "bookmarks/static/bundle.js",
      "bookmarks/static/bundle.js.map",
      "bookmarks/static/theme-light.css",
      "bookmarks/static/theme-dark.css",
      "data"
    ],
    "env": {
      "UV_PROJECT_ENVIRONMENT": "/etc/linkding/.venv",
      "UV_NO_SYNC": "1",
      "UV_OFFLINE": "1"
    }
  },
  "browserLogin": {
    "path": "/login/",
    "usernameLabel": "Username",
    "passwordLabel": "Password",
    "submitLabel": "Login",
    "usernameEnv": "LD_SUPERUSER_NAME",
    "passwordEnv": "LD_SUPERUSER_PASSWORD"
  },
  "testSelectionHint": "Name targeted test files under bookmarks/tests/; the full suite takes about 300 s.",
  "regression": { "suite": ["uv", "run", "manage.py", "test", "bookmarks.tests", "--parallel", "2"], "format": "django", "timeoutS": 1800 },
  "testData": "test-data.json",
  "runtimeRulesChecklist": "runtime-rules/adapters/linkding-checklist.md"
}
